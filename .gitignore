# Book photos and OCR of them stay local (P4)
wp0/fixtures/private/
# Model weights and exports (D6): hundreds of MB, never in git; `make models` rebuilds them
wp0/models/
app/assets/models/*
!app/assets/models/.gitkeep
*.onnx
# The synthetic goldens (WP0b, P4: rendered text, no book content) ARE committed, PNG and JSON
!app/test/goldens/
!app/test/goldens/**
*.pt
*.safetensors
*.bin
# Python
wp0/.venv/
__pycache__/
*.pyc
# OS
.DS_Store
# Per-machine Claude Code permissions (the shared allowlist is .claude/settings.json)
.claude/settings.local.json
# Signing material, exports and local secrets never enter git
*.p12
*.mobileprovision
*.cer
.env
.env.*
*.ipa
*.xcarchive
ExportOptions.plist
# Agent worktrees
.claude/worktrees/
# Benchmark outputs contain OCRed book text (P4)
wp0/results/
# ONNX Runtime macOS binary and headers, fetched by `make ort-macos` (sha256 pinned in the Makefile)
app/packages/ort_ffi/tool/ort/
!app/packages/ort_ffi/test/fixtures/*.onnx
# WP3 dictionary: upstream downloads (data, ~130 MB unpacked) and the built asset (~100 MB)
tool/dict/downloads/
tool/dict/.dart_tool/
tool/dict/.flutter-plugins-dependencies
app/assets/dict/dictionary.sqlite
app/assets/dict/dictionary.version
